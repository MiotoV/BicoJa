# Copie para .env e preencha:  cp .env.example .env
# Gere a chave com: python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (usado pelo PostgreSQL e pelo Django)
POSTGRES_DB=bicoja
POSTGRES_USER=bicoja
POSTGRES_PASSWORD=bicoja
DB_HOST=db

# Endereço do painel administrativo (termine com /). Use um valor difícil de adivinhar.
DJANGO_ADMIN_URL=admin/